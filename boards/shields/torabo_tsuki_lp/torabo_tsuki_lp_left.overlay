#define TORABO_TSUKI_LP_MATRIX_COL_OFFSET 0

#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&pointing_listener {
    /* Same pointing pipeline as right; used when this side is central with a trackball.
     * Cursor: 7/8 (0.875x). Scroll sensitivity is tuned separately via zip_scroll_scaler. */
    input-processors =
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        <&zip_xy_scaler 7 8>;

    /* Layer 3: XY movement -> vertical/horizontal scroll (ZMK zip_xy_to_scroll_mapper).
     * Override replaces base processors while the layer is active.
     * zip_scroll_transform Y_INVERT flips vertical wheel only vs previous Layer 2 feel. */
    scroller {
        layers = <3>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_scroll_scaler 1 1>;
    };
};
