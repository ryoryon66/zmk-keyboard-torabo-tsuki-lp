#define TORABO_TSUKI_LP_RIGHT 1
#define TORABO_TSUKI_LP_MATRIX_COL_OFFSET 7

#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&pointing_listener {
    /* Cursor sensitivity: 7/8 (0.875x) via software scaler so scroll can stay independent.
     * CPI is left at the PAW3222 default (no res-cpi) because a sensor CPI change would
     * scale both cursor and scroll together. */
    input-processors =
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        <&zip_xy_scaler 7 8>;

    /* Layer 3: XY movement -> vertical/horizontal scroll (ZMK zip_xy_to_scroll_mapper).
     * Override replaces base processors while the layer is active.
     * zip_scroll_scaler here is independent of the cursor zip_xy_scaler above.
     * zip_scroll_transform Y_INVERT flips vertical wheel only vs previous Layer 2 feel. */
    scroller {
        layers = <3>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_scroll_scaler 1 1>;
    };
};

&size_s_transform {
    col-offset = <7>;
};

&size_m_transform {
    col-offset = <7>;
};

&size_l_transform {
    col-offset = <7>;
};
